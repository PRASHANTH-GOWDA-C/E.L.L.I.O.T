# Normalise all text files to LF in the repository.
* text=auto eol=lf

# Windows batch files must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gguf binary
*.db binary
