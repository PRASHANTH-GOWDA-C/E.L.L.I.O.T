# Copy this file to .env and adjust as needed.

# Port the Elliot web server listens on.
PORT=3000

# Base URL of the local Ollama server.
OLLAMA_URL=http://127.0.0.1:11434

# AI mode: "offline" (local models only) or "online".
AI_MODE=offline

# --- Models (any name from `ollama list`) ---
# Always loaded:
#   CODER_MODEL  main brain: code + chat
#   TOOLS_MODEL  tool calls (spec target: granite4.2:3b)
#   EMBED_MODEL  memory search
CODER_MODEL=qwen2.5-coder:7b
TOOLS_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

# Loaded on demand:
#   REASON_MODEL  hard debugging / logic
#   VISION_MODEL  screenshots + general chat
#   FAST_MODEL    quick answers / weak PCs (spec target: qwen3.5:0.8b)
REASON_MODEL=deepseek-r1:8b
VISION_MODEL=qwen3.5:9b
FAST_MODEL=qwen3:4b
